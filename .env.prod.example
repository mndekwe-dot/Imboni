# Production environment for docker-compose.prod.yml.
# Copy to `.env.prod` (gitignored) and fill in real values, then run:
#   bash scripts/init-letsencrypt.sh     # once, to get the first certificate
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ── Domain and TLS ────────────────────────────────────────────────────────────
# Your apex domain, no scheme and no trailing dot. Schools live on subdomains
# of it (school1.imboni.rw), and nginx looks for the certificate under
# /etc/letsencrypt/live/$DOMAIN/.
DOMAIN=imboni.rw

# Let's Encrypt sends expiry and revocation warnings here. Use a real inbox.
CERT_EMAIL=admin@imboni.rw

# Comma-separated school subdomains to include on the certificate, WITHOUT the
# domain part (school1,school2 -> school1.imboni.rw, school2.imboni.rw).
#
# The http-01 challenge cannot issue a wildcard certificate, so every school
# hostname has to be listed. Adding a school means adding it here and re-running
# scripts/init-letsencrypt.sh. True wildcard coverage needs a dns-01 challenge
# and a certbot plugin for your DNS provider.
CERT_SUBDOMAINS=

# ── Django ────────────────────────────────────────────────────────────────────
THE_SECRET_KEY=change-me-to-a-long-random-secret
# Leading dot covers every school subdomain, e.g. .imboni.rw
ALLOWED_HOSTS=.imboni.rw

# ── Postgres (the same password is used by the db container and the app) ──────
DATABASE_PASSWORD=change-me-strong-db-password

# ── Email ─────────────────────────────────────────────────────────────────────
# Required for invitations, password resets and the weekly parent digest to
# actually send. With these unset, Django tries smtp.gmail.com with no
# credentials and every send fails. For Gmail use an App Password, not the
# account password.
MY_EMAIL_HOST_USER=
MY_EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Imboni School <no-reply@imboni.rw>

# The origin used in invitation and password-reset links.
FRONTEND_URL=https://imboni.rw

# ── Optional tuning ───────────────────────────────────────────────────────────
# Note: the backend runs uvicorn (ASGI), so this is UVICORN_WORKERS, not
# GUNICORN_WORKERS. A gunicorn variable here is read by nothing.
UVICORN_WORKERS=4
CELERY_CONCURRENCY=4

# ── Optional integrations ─────────────────────────────────────────────────────
# Stripe billing stays disabled unless a secret key is set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Error monitoring. Left blank, Sentry is not initialised at all.
SENTRY_DSN=

# SMS delivery for invitations (Africa's Talking).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
